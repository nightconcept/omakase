#!/bin/bash
# Omakase Testing Loop - Comprehensive validation script
# Usage: ./bin/omakase-test [--dry-run] [--full] [--vm]

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m' # No Color

# Script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Options
DRY_RUN=false
FULL_TEST=false
VM_TEST=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --full)
            FULL_TEST=true
            shift
            ;;
        --vm)
            VM_TEST=true
            shift
            ;;
        --help|-h)
            echo "Omakase Testing Loop"
            echo ""
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --dry-run    Run validation tests only (no builds)"
            echo "  --full       Run comprehensive testing including builds"
            echo "  --vm         VM testing mode (requires clean VM)"
            echo "  --help,-h    Show this help message"
            echo ""
            echo "Test Categories:"
            echo "  1. Structure Verification"
            echo "  2. Syntax Validation"
            echo "  3. Build Validation (dry-run or full)"
            echo "  4. VM Integration Testing (with --vm)"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

log() {
    echo -e "${BLUE}[$(date +'%H:%M:%S')]${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

error() {
    echo -e "${RED}✗${NC} $1"
}

section() {
    echo ""
    echo -e "${PURPLE}=== $1 ===${NC}"
}

run_command() {
    local cmd="$1"
    local description="$2"
    
    log "Running: $description"
    echo "Command: $cmd"
    
    if eval "$cmd"; then
        success "$description"
        return 0
    else
        error "$description failed"
        return 1
    fi
}

# Change to project root
cd "$PROJECT_ROOT"

echo -e "${PURPLE}"
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║                    OMAKASE TESTING LOOP                     ║"
echo "╠══════════════════════════════════════════════════════════════╣"
echo "║  Phase 2 Validation: Package Installation Strategy          ║"
echo "╚══════════════════════════════════════════════════════════════╝"
echo -e "${NC}"

if $DRY_RUN; then
    echo -e "${YELLOW}Mode: DRY RUN (validation only)${NC}"
elif $FULL_TEST; then
    echo -e "${GREEN}Mode: FULL TEST (with builds)${NC}"
elif $VM_TEST; then
    echo -e "${BLUE}Mode: VM TESTING${NC}"
else
    echo -e "${BLUE}Mode: STANDARD (syntax + dry-run builds)${NC}"
fi

echo ""

# Track test results
TESTS_PASSED=0
TESTS_FAILED=0

test_result() {
    if [[ $? -eq 0 ]]; then
        ((TESTS_PASSED++))
    else
        ((TESTS_FAILED++))
    fi
}

#######################
# 1. STRUCTURE VERIFICATION
#######################

section "1. Structure Verification"

log "Checking project structure..."

# Check for required directories
for dir in applications modules home bin config; do
    if [[ -d "$dir" ]]; then
        success "Directory exists: $dir"
    else
        error "Missing directory: $dir"
    fi
    test_result
done

# Check for Nix files
NIX_FILES=$(find . -name "*.nix" -type f | wc -l)
if [[ $NIX_FILES -gt 10 ]]; then
    success "Found $NIX_FILES Nix files (expected >10)"
else
    error "Only found $NIX_FILES Nix files (expected >10)"
fi
test_result

# Check application modules
log "Checking application modules..."
EXPECTED_APPS=(nixvim wezterm waybar zsh hyprland mako walker)
for app in "${EXPECTED_APPS[@]}"; do
    if [[ -f "applications/$app/default.nix" ]]; then
        success "Application module exists: $app"
    else
        error "Missing application module: $app"
    fi
    test_result
done

# Check root modules
log "Checking root modules..."
EXPECTED_MODULES=(desktop.nix development.nix hardware.nix audio.nix themes.nix default.nix)
for module in "${EXPECTED_MODULES[@]}"; do
    if [[ -f "modules/$module" ]]; then
        success "Module exists: $module"
    else
        error "Missing module: $module"
    fi
    test_result
done

#######################
# 2. SYNTAX VALIDATION
#######################

section "2. Syntax Validation"

# Check main flake syntax
run_command "nix-instantiate --parse flake.nix" "Main flake syntax check"
test_result

# Check module syntax
run_command "nix-instantiate --parse modules/default.nix" "Modules syntax check"
test_result

# Check home configuration syntax
run_command "nix-instantiate --parse home/home.nix" "Home config syntax check"
test_result

# Check each application module
log "Validating application module syntax..."
for app_dir in applications/*/; do
    if [[ -f "$app_dir/default.nix" ]]; then
        app_name=$(basename "$app_dir")
        if run_command "nix-instantiate --parse $app_dir/default.nix" "Application syntax: $app_name"; then
            success "Syntax valid: $app_name"
        else
            error "Syntax error: $app_name"
        fi
        test_result
    fi
done

# Flake structure validation
run_command "nix flake check --no-build" "Flake structure validation"
test_result

#######################
# 3. BUILD VALIDATION
#######################

section "3. Build Validation"

if $DRY_RUN; then
    log "Skipping builds in dry-run mode"
else
    # Test Home Manager configuration build
    run_command "nix build .#homeConfigurations.danny.activationPackage --dry-run" "Home Manager build (dry-run)"
    test_result

    if $FULL_TEST; then
        log "Running full builds..."
        
        # Actual build test (without applying)
        run_command "home-manager build --flake .#danny" "Home Manager full build"
        test_result
        
        # Check if activation package can be built
        run_command "nix build .#homeConfigurations.danny.activationPackage" "Build activation package"
        test_result
        
        log "Full build tests completed"
    else
        log "Skipping full builds (use --full for complete build testing)"
    fi
fi

#######################
# 4. PACKAGE VALIDATION
#######################

section "4. Package Validation"

# Check if key packages are available in current nixpkgs
log "Checking package availability..."

KEY_PACKAGES=(
    "hyprland" "waybar" "mako" "wezterm" "firefox"
    "bat" "eza" "ripgrep" "fd" "fzf" "lazygit"
    "devenv" "direnv" "uv" "podman"
)

for pkg in "${KEY_PACKAGES[@]}"; do
    if nix-env -qa --available "$pkg" | grep -q "$pkg"; then
        success "Package available: $pkg"
    else
        warning "Package check inconclusive: $pkg"
    fi
    test_result
done

#######################
# 5. VM TESTING MODE
#######################

if $VM_TEST; then
    section "5. VM Testing Mode"
    
    log "VM Testing requires a clean Debian-based system"
    log "This should be run on a fresh VM or container"
    
    # Check if we're likely in a VM/container
    if [[ -f /.dockerenv ]] || [[ -n "${container:-}" ]] || [[ $(systemd-detect-virt 2>/dev/null) != "none" ]]; then
        success "Detected virtualized environment"
    else
        warning "Not detected as virtualized - proceed with caution"
    fi
    
    # VM-specific tests
    log "Testing bootstrap readiness..."
    
    # Check if git and curl are available
    if command -v git &> /dev/null && command -v curl &> /dev/null; then
        success "Bootstrap requirements met (git, curl)"
    else
        error "Missing bootstrap requirements"
    fi
    test_result
    
    # Test install.sh in dry-run mode if available
    if [[ -f "install.sh" ]]; then
        log "Testing install.sh dry-run capability..."
        if bash install.sh --help &> /dev/null || bash install.sh --dry-run &> /dev/null; then
            success "install.sh supports dry-run"
        else
            warning "install.sh may not support dry-run"
        fi
    fi
    
    # Provide VM testing instructions
    log "For complete VM testing:"
    echo "1. Create fresh Debian 12 VM"
    echo "2. Run: curl -sSf https://raw.githubusercontent.com/your-repo/omakase/main/boot.sh | bash"
    echo "3. Or manually: git clone repo && cd omakase && bash install.sh"
    echo "4. Verify: home-manager switch --flake .#danny"
fi

#######################
# RESULTS SUMMARY
#######################

section "Test Results Summary"

echo ""
echo -e "${GREEN}Tests Passed: $TESTS_PASSED${NC}"
echo -e "${RED}Tests Failed: $TESTS_FAILED${NC}"

if [[ $TESTS_FAILED -eq 0 ]]; then
    echo ""
    success "🎉 ALL TESTS PASSED!"
    echo ""
    echo "Next steps:"
    echo "  • Ready for Phase 3: Configuration Architecture"
    echo "  • Test on VM: $0 --vm"
    echo "  • Full build test: $0 --full"
    echo "  • Apply configuration: home-manager switch --flake .#danny"
    exit 0
else
    echo ""
    error "❌ SOME TESTS FAILED!"
    echo ""
    echo "Please fix the failing tests before proceeding."
    echo "Run with --help for more options."
    exit 1
fi